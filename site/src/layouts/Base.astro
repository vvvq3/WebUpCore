---
// Общий шаблон страницы: SEO, шрифты, стили, меню на телефоне, форма заявки, cookie-баннер, аналитика.
import '../styles/global.css';
import '../styles/theme-light.css';
import { lightCss } from '../data/theme';
// предзагрузка основных шрифтов (заголовки — Bricolage, кириллица — Onest)
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import onestCyr from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';
import MobileMenu from '../components/MobileMenu.astro';
import LeadForm from '../components/LeadForm.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Analytics from '../components/Analytics.astro';
import { PRODUCT_COLORS, ui, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
  page: string; // home | grade | ai | projects | mentor | blog | blog-2 | blog-3 | 404
  title: string;
  description: string;
  keywords?: string;
  route: string; // путь без языкового префикса, например 'grade/'
  jsonLd?: object[];
  noindex?: boolean;
}
const { lang, page, title, description, keywords, route, jsonLd = [], noindex = false } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, '');
const ruUrl = `${site}/${route}`;
const enUrl = `${site}/en/${route}`;
const canonical = lang === 'ru' ? ruUrl : enUrl;
const hasEn = !page.startsWith('blog'); // раунд 95: английского блога нет — без hreflang на /en/blog/
const ogLang = lang === 'ru' ? 'ru_RU' : 'en_US';
const ogKey = page === '404' ? 'home' : page.replace(/-\d$/, '');
const ogImage = `${site}/og/${lang}-${ogKey}.png`;
const accKey = (page.startsWith('blog') ? 'blog' : page === '404' ? 'home' : page) as keyof typeof PRODUCT_COLORS;
const acc = PRODUCT_COLORS[accKey];
const t = ui[lang];
---
<!doctype html>
<html lang={lang} style={`--acc-line: ${acc.line}; --acc-text: ${acc.text};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && hasEn && <link rel="alternate" hreflang="ru" href={ruUrl} />}
    {!noindex && hasEn && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!noindex && hasEn && <link rel="alternate" hreflang="x-default" href={ruUrl} />}
    <meta name="theme-color" content="#0D0C15" />
    <meta name="color-scheme" content="dark" />
    {lang === 'ru' && <script is:inline>(function(){try{if(localStorage.getItem('uc-theme')==='light'){var d=document.documentElement;d.setAttribute('data-theme','light');var m=document.querySelector('meta[name="theme-color"]');if(m)m.setAttribute('content','#F4F6FA');var c=document.querySelector('meta[name="color-scheme"]');if(c)c.setAttribute('content','light');}}catch(e){}})();</script>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UpCore" />
    <meta property="og:locale" content={ogLang} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lang === 'ru' ? onestCyr : onestLatin} as="font" type="font/woff2" crossorigin />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <Analytics />
    <style is:global set:html={lightCss()} />
  </head>
  <body data-page={page} data-lang={lang}>
    <a class="uc-skip" href="#main">{t.skip}</a>
    <main id="main">
      <slot />
    </main>
    <MobileMenu lang={lang} page={page} route={route} />
    <LeadForm lang={lang} page={page} />
    <CookieBanner lang={lang} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
