# Шаблон: при старте контейнера nginx подставляет ${NGINX_LOCAL_RESOLVERS} и пишет результат в /etc/nginx/conf.d/default.conf.

# защита формы заявок от спама: не больше 10 заявок в минуту с одного адреса
# (за прокси/балансировщиком адрес посетителя — первый в X-Forwarded-For)
map $http_x_forwarded_for $lead_client {
    ""                  $binary_remote_addr;
    "~^(?<lead_ip>[^,\s]+)"  $lead_ip;
}
limit_req_zone $lead_client zone=lead:1m rate=10r/m;

js_path /etc/nginx/njs/;
js_import lead from lead.js;
js_fetch_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
js_fetch_timeout 10s;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    # редиректы относительные — корректно за внешним прокси/балансировщиком с HTTPS
    absolute_redirect off;

    # сжатие (стили встроены в HTML)
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml text/xml;

    # заголовки безопасности (add_header внутри location отменяет серверные, поэтому повторены в каждом location)
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # адрес без слеша → со слешем (/grade → /grade/, /en → /en/), если есть такая папка
    location ~ ^([^.?]*[^/])$ {
        if (-d $document_root$1) { return 301 $1/$is_args$args; }
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/index.html =404;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
    }

    # файлы с хэшем в имени — кэш на год
    location /_astro/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
    }

    # картинки и OG-превью — кэш на 30 дней
    location ~* ^/(img|og)/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=2592000";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
    }

    # заявка с формы → Telegram (nginx/lead.js); токен и получатели — переменные окружения TG_BOT_TOKEN, TG_CHAT_ID
    location = /api/lead {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=300s ipv6=off;
        limit_req zone=lead burst=5 nodelay;
        limit_req_status 429;
        client_max_body_size 16k;
        client_body_buffer_size 16k;
        js_content lead.handle;
    }

    error_page 404 /404.html;
}
