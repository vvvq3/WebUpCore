# Скопируйте в .env и заполните, когда будут данные.
# Номер счётчика Яндекс Метрики (только цифры). Пусто — аналитика не подключается.
PUBLIC_YM_ID=
# Адрес обработчика формы заявки (POST, multipart/form-data). Пусто — форма открывает письмо на почту с заполненными полями.
PUBLIC_FORM_ENDPOINT=
# Почта для заявок (используется и в письме-запасном варианте).
PUBLIC_FORM_EMAIL=office@dex-it.ru
